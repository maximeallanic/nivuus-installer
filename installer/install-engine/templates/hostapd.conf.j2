# hostapd configuration — generated by the Nivuus installer
# Band: {{ band }} ({{ 'wlp* 2.4GHz' if hw_mode == 'g' else '5GHz' }})
interface={{ interface }}
driver=nl80211
bridge={{ bridge }}

hw_mode={{ hw_mode }}
channel={{ channel }}
country_code={{ country }}
ieee80211n=1
{% if hw_mode == 'a' %}ieee80211ac=1
ieee80211d=1
ieee80211h=1
{% endif %}
ht_capab=[HT40+][SHORT-GI-20][SHORT-GI40][LDPC][TX-STBC][RX-STBC1]

device_name=Nivuus
manufacturer=Nivuus
model_name=Nivuus Server

# WMM / QoS — favour latency for game streaming
wmm_enabled=1
beacon_int=100
dtim_period=3
wps_state=0
ap_setup_locked=1

# Primary (private) SSID -> trusted bridge
ssid={{ private_ssid }}
auth_algs=3
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase={{ private_passphrase }}
{% if public_ssid %}
# Secondary (public/guest) SSID -> public bridge
bss={{ public_iface }}
ssid={{ public_ssid }}
bridge={{ public_bridge }}
auth_algs=3
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
wpa_passphrase={{ public_passphrase }}
access_network_type=1
{% endif %}
